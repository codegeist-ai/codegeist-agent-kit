{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "INDEX.md",
    ".opencode/rules/*.md"
  ],
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/output/**",
      "**/tmp/**",
      "**/.codegeist/.local.env",
      "**/.codegeist/secrets.env",
      "**/.codegeist/secrets/**"
    ]
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--sandbox",
        "--config",
        ".opencode/playwright-mcp.json"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_USER_DATA_DIR": ".chrome"
      },
      "enabled": true,
      "timeout": 30000
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 15000
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": true,
      "timeout": 15000
    }
  },
  "permission": {
    "read": {
      ".codegeist/.local.env": "deny",
      ".codegeist/secrets.env": "deny",
      ".codegeist/secrets": "deny",
      ".codegeist/secrets/**": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
